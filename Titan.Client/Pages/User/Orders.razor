@page "/orders"
@inject OrderService OrderSvc
@inject AuthService Auth
@inject NavigationManager Nav
@inject SignalRService SignalR
@inject ToastService Toast
@implements IAsyncDisposable

<PageTitle>My Orders — TITAN</PageTitle>

<div class="main-content" style="padding-top:92px;padding-bottom:60px">
    <div class="container">
        <h1 style="font-size:2rem;margin-bottom:32px">My Orders</h1>

        @if (_loading)
        {
            <div style="text-align:center;padding:60px">
                <i class="fas fa-spinner fa-spin" style="font-size:2rem;color:var(--gold)"></i>
            </div>
        }
        else if (!_orders.Any())
        {
            <div class="card" style="text-align:center;padding:80px">
                <i class="fas fa-box-open" style="font-size:3.5rem;color:var(--gold);opacity:.25;margin-bottom:22px;display:block"></i>
                <h3>No orders yet</h3>
                <p style="color:var(--silver-dim);margin-bottom:26px">Start shopping and your orders will appear here.</p>
                <a href="/shop" class="btn btn-gold">Shop Now</a>
            </div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:14px">
                @foreach (var o in _orders)
                {
                    <div class="card card-hover" style="cursor:pointer" @onclick='() => Nav.NavigateTo($"/orders/{o.Id}")'>
                        <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px">
                            <div>
                                <div style="display:flex;align-items:center;gap:12px;margin-bottom:6px">
                                    <span style="color:var(--gold);font-weight:700;font-size:1rem">@o.OrderNumber</span>
                                    <span class="badge @StatusBadge(o.Status)">@o.Status</span>
                                </div>
                                <p style="color:var(--silver-dim);font-size:.82rem">@o.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                            </div>
                            <div style="text-align:right">
                                <p style="color:var(--gold);font-size:1.25rem;font-weight:700">$@o.TotalAmount.ToString("F2")</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    List<OrderDto> _orders = new();
    bool _loading = true;
    int _page = 1;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        SignalR.OnOrderUpdate += HandleOrderUpdate;
        await Load();
    }

    private void HandleOrderUpdate(OrderDto updated)
    {
        // If the order has been cancelled, remove it from the My Orders list
        if (updated.Status == OrderStatus.Cancelled)
        {
            _orders.RemoveAll(o => o.Id == updated.Id);
        }
        else
        {
            var order = _orders.FirstOrDefault(o => o.Id == updated.Id);
            if (order != null)
            {
                order.Status = updated.Status;
            }
        }

        InvokeAsync(StateHasChanged);
    }

    async Task Load()
    {
        _loading = true;
        try
        {
            var r = await OrderSvc.GetMyOrdersAsync(_page, 10);
            // Filter out cancelled orders so they disappear from this list
            _orders = r?.Items?.Where(o => o.Status != OrderStatus.Cancelled).ToList() ?? new();
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to load orders: {ex.Message}");
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    static string StatusBadge(OrderStatus s) => s switch
    {
        OrderStatus.Delivered => "badge-success",
        OrderStatus.Cancelled or OrderStatus.Failed => "badge-danger",
        _ => "badge-warning"
    };

    public ValueTask DisposeAsync()
    {
        SignalR.OnOrderUpdate -= HandleOrderUpdate;
        return ValueTask.CompletedTask;
    }
}