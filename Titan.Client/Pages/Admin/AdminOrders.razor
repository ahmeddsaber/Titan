@page "/admin/orders"
@using Titan.Client.Services.Models
@using Titan.Domain.Enum

@inject OrderService OrderSvc
@inject ToastService Toast
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SignalRService SignalR
@implements IAsyncDisposable

<PageTitle>Orders — Admin TITAN</PageTitle>

@if (!Auth.IsAdmin)
{
    Nav.NavigateTo("/admin/orders");
    return;
}

<div class="main-content" style="padding-top:90px">
    <div style="display:flex">
        <AdminSidebar Active="orders" />
        <div style="flex:1;padding:36px;min-width:0">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:28px;flex-wrap:wrap;gap:14px">
                <div>
                    <h1 style="font-size:2rem;margin-bottom:4px">Orders</h1>
                    <p style="color:var(--silver-dim)">@_total orders total</p>
                </div>
                <div style="display:flex;gap:7px;flex-wrap:wrap">
                    @foreach (var (lbl, val) in _tabs)
                    {
                        <button class="btn @(_statusFilter == val ? "btn-gold" : "btn-outline-silver") btn-sm"
                                @onclick="() => SetStatus(val)">
                            @lbl
                        </button>
                    }
                </div>
            </div>

            @if (_loading)
            {
                <div style="text-align:center;padding:60px">
                    <i class="fas fa-spinner fa-spin" style="font-size:2rem;color:var(--gold)"></i>
                </div>
            }
            else
            {
                <div class="card" style="padding:0;overflow:hidden">
                    <table class="t-admin">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in _orders)
                            {
                                <tr>
                                    <td style="color:var(--gold);font-weight:700;font-family:monospace">@o.OrderNumber</td>
                                    <td>
                                        <p style="color:var(--white);font-size:.87rem;font-weight:600">@o.ShippingFullName</p>
                                        <p style="color:var(--silver-dim);font-size:.75rem">@o.ShippingCity, @o.ShippingCountry</p>
                                    </td>
                                    <td style="color:var(--silver)">@o.Items.Count</td>
                                    <td style="color:var(--gold);font-weight:700">$@o.TotalAmount.ToString("F2")</td>
                                    <td><span class="badge @SBadge(o.Status)">@o.Status</span></td>
                                    <td style="color:var(--silver-dim);font-size:.78rem">@o.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <button class="btn btn-outline-gold btn-sm" @onclick="() => Open(o)">
                                            <i class="fas fa-edit"></i> Manage
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (!_orders.Any())
                    {
                        <div style="text-align:center;padding:60px;color:var(--silver-dim)">
                            <i class="fas fa-inbox" style="font-size:2rem;opacity:.2;margin-bottom:12px;display:block"></i>
                            No orders found
                        </div>
                    }
                </div>

                @if (_totalPages > 1)
                {
                    <div style="display:flex;gap:7px;justify-content:center;margin-top:22px">
                        @for (int i = 1; i <= _totalPages; i++)
                        {
                            var pg = i;
                            <button class="page-btn @(_page == pg ? "active" : "")"
                                    @onclick="() => GoPage(pg)">
                                @pg
                            </button>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- ORDER MODAL -->
@if (_sel is not null)
{
    <div class="modal-bg" @onclick="() => _sel = null">
        <div class="card modal-box" @onclick:stopPropagation>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
                <h3>@_sel.OrderNumber</h3>
                <button @onclick="() => _sel = null" style="background:none;border:none;color:var(--silver);cursor:pointer;font-size:1.1rem">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Customer -->
            <div style="background:var(--black);border-radius:var(--r);padding:14px;margin-bottom:18px">
                <h4 style="font-size:.7rem;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:10px">Customer</h4>
                <p style="color:var(--white);font-weight:600">@_sel.ShippingFullName</p>
                <p style="color:var(--silver-dim);font-size:.85rem">@_sel.ShippingPhone</p>
                <p style="color:var(--silver-dim);font-size:.85rem;margin-top:6px">@_sel.ShippingAddress, @_sel.ShippingCity, @_sel.ShippingCountry</p>
            </div>

            <!-- Items -->
            <div style="margin-bottom:18px">
                <h4 style="font-size:.7rem;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:10px">Items (@_sel.Items.Count)</h4>
                @foreach (var item in _sel.Items)
                {
                    <div style="display:flex;gap:11px;padding:9px 0;border-bottom:1px solid var(--black-border)">
                        <img src="@item.ProductImageUrl" style="width:42px;height:54px;object-fit:cover;border-radius:4px" />
                        <div style="flex:1">
                            <p style="color:var(--white);font-size:.87rem;font-weight:600">@item.ProductName</p>
                            @if (!string.IsNullOrEmpty(item.VariantInfo))
                            {
                                <p style="color:var(--silver-dim);font-size:.75rem">@item.VariantInfo</p>
                            }
                            <p style="color:var(--silver-dim);font-size:.8rem">Qty: @item.Quantity × $@item.UnitPrice.ToString("F2")</p>
                        </div>
                        <p style="color:var(--gold);font-weight:700">$@item.TotalPrice.ToString("F2")</p>
                    </div>
                }
                <p style="text-align:right;color:var(--white);font-weight:700;margin-top:10px">Total: <span style="color:var(--gold)">$@_sel.TotalAmount.ToString("F2")</span></p>
            </div>

            <!-- Update Status -->
            <div style="background:var(--black);border-radius:var(--r);padding:14px">
                <h4 style="font-size:.7rem;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:12px">Update Status</h4>
                <select class="form-control" @bind="_newStatus" style="margin-bottom:10px">
                    @foreach (OrderStatus s in Enum.GetValues<OrderStatus>())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
                <textarea class="form-control" rows="2" @bind="_statusNote" placeholder="Optional note…" style="margin-bottom:12px"></textarea>
                <button class="btn btn-gold" @onclick="UpdateStatus" disabled="@_updating">
                    @if (_updating)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                    }
                    else
                    {

                        <i class="fas fa-check"></i>
                    }
                    Update Status
                </button>
            </div>
        </div>
    </div>
}

@code {
    List<OrderDto> _orders = new();
    OrderDto? _sel;
    bool _loading = true, _updating;
    int _page = 1, _totalPages = 1, _total;
    OrderStatus? _statusFilter;
    OrderStatus _newStatus;
    string _statusNote = "";

    readonly (string lbl, OrderStatus? val)[] _tabs =
    [
        ("All", null), ("Pending", OrderStatus.Pending), ("Confirmed", OrderStatus.Confirmed),
        ("Processing", OrderStatus.Processing), ("Shipped", OrderStatus.Shipped),
        ("Delivered", OrderStatus.Delivered), ("Cancelled", OrderStatus.Cancelled),
    ];

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAdmin) return;
        SignalR.OnOrderUpdate += HandleOrderUpdate;
        await Load();
    }

    private void HandleOrderUpdate(OrderDto updated)
    {
        var idx = _orders.FindIndex(o => o.Id == updated.Id);
        if (idx != -1)
        {
            _orders[idx] = updated;
        }

        if (_sel?.Id == updated.Id)
        {
            _sel = updated;
            _newStatus = updated.Status;
        }

        InvokeAsync(StateHasChanged);
    }

    async Task Load()
    {
        _loading = true;
        try
        {
            var r = await OrderSvc.GetAllAsync(_page, 20, _statusFilter);
            _orders = r?.Items ?? new();
            _total = r?.TotalCount ?? 0;
            _totalPages = r?.TotalPages ?? 1;
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to load orders: {ex.Message}");
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task SetStatus(OrderStatus? s) { _statusFilter = s; _page = 1; await Load(); }
    async Task GoPage(int p) { _page = p; await Load(); }

    void Open(OrderDto o)
    {
        _sel = o;
        _newStatus = o.Status;
        _statusNote = "";
    }

    async Task UpdateStatus()
    {
        if (_sel is null) return;

        _updating = true;
        try
        {
            var result = await OrderSvc.UpdateStatusAsync(_sel.Id, _newStatus, _statusNote);

            if (result?.Success == true && result.Data != null)
            {
                Toast.Success($"Order updated to {_newStatus}");

                // Update local state immediately for instant rendering
                var idx = _orders.FindIndex(o => o.Id == _sel.Id);
                if (idx != -1)
                {
                    _orders[idx] = result.Data;
                }

                _sel = result.Data; // Keep modal updated with new status and history
                _statusNote = "";   // Clear status note

                await InvokeAsync(StateHasChanged);

                // Close the modal gently after 1 second so the admin can verify the success state
                _ = Task.Delay(1000).ContinueWith(async _ =>
                {
                    _sel = null;
                    await InvokeAsync(StateHasChanged);
                });

                // Load in the background to ensure counts and filters are perfectly in sync
                _ = Load();
            }
            else
            {
                Toast.Error(result?.Message ?? "Failed to update status");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"An error occurred: {ex.Message}");
        }
        finally
        {
            _updating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    static string SBadge(OrderStatus s) => s switch
    {
        OrderStatus.Delivered => "badge-success",
        OrderStatus.Cancelled or OrderStatus.Failed => "badge-danger",
        OrderStatus.Shipped or OrderStatus.OutForDelivery => "badge-info",
        _ => "badge-warning"
    };

    async Task Print() => await JS.InvokeVoidAsync("TitanJS.printElement", "order-print");

    public ValueTask DisposeAsync()
    {
        SignalR.OnOrderUpdate -= HandleOrderUpdate;
        return ValueTask.CompletedTask;
    }
}