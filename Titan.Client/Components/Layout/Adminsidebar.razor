@inject AuthService Auth
@inject NavigationManager Nav

<aside style="width:252px;min-height:calc(100vh - 70px);background:var(--black-card);border-right:1px solid var(--black-border);padding:24px 0;flex-shrink:0;position:sticky;top:70px;height:calc(100vh - 70px);overflow-y:auto;display:flex;flex-direction:column">

    <div style="padding:0 22px 22px;border-bottom:1px solid var(--black-border);margin-bottom:8px">
        <div class="brand-font" style="font-size:1.6rem;letter-spacing:5px;color:var(--white)">TIT<span style="color:var(--gold)">A</span>N</div>
        <p style="font-size:.68rem;letter-spacing:4px;color:var(--gold);text-transform:uppercase;margin-top:2px">Admin Panel</p>
    </div>

    <nav style="flex:1">
        <ul style="list-style:none">
            @foreach (var m in _menu)
            {
                var active = Active == m.key;
                <li>
                    <a href="@m.href"
                       style="display:flex;align-items:center;gap:11px;padding:11px 22px;text-decoration:none;font-size:.85rem;font-weight:600;transition:all .2s;
                        border-right:2px solid @(active ? "var(--gold)" : "transparent");
                        color:@(active ? "var(--gold)" : "var(--silver)");
                        background:@(active ? "rgba(212,175,55,.07)" : "transparent")">
                        <i class="@m.icon" style="width:16px;text-align:center;opacity:@(active ? "1" : ".6")"></i>
                        @m.label
                    </a>
                </li>
            }
        </ul>
    </nav>

    <div style="padding:18px 22px;border-top:1px solid var(--black-border)">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
            <div style="width:34px;height:34px;border-radius:50%;background:rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:.85rem;flex-shrink:0">
                <i class="fas fa-user-shield"></i>
            </div>
            <div style="min-width:0">
                <p style="color:var(--white);font-size:.82rem;font-weight:700;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@Auth.User?.FullName</p>
                <p style="color:var(--silver-dim);font-size:.72rem;margin:0">Administrator</p>
            </div>
        </div>
        <a href="/" style="display:flex;align-items:center;gap:7px;color:var(--silver-dim);font-size:.78rem;text-decoration:none">
            <i class="fas fa-store"></i> Back to Store
        </a>
    </div>
</aside>

@code {
    [Parameter] public string Active { get; set; } = "";

    readonly (string key, string label, string icon, string href)[] _menu =
    [
      ("dashboard",  "Dashboard",      "fas fa-chart-pie",     "/admin"),
    ("products",   "Products",       "fas fa-tshirt",        "/admin/products"),
    ("categories", "Categories",     "fas fa-tags",          "/admin/categories"),
    ("orders",     "Orders",         "fas fa-shopping-cart", "/admin/orders"),
    ("users",      "Users",          "fas fa-users",         "/admin/users"),
    ("coupons",    "Coupons",        "fas fa-ticket-alt",    "/admin/coupons"),
    ("logs",       "Activity Logs",  "fas fa-history",       "/admin/logs"),
  ];
}
